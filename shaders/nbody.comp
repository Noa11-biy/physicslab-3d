#version 450
// M7 : accélérations gravitationnelles de N corps, O(N^2) par tuiles (voir GpuNBody.hpp).
//
//   a_i = G sum_j m_j (r_j - r_i) / (|r_j - r_i|^2 + eps^2)^(3/2)
//
// Un thread par corps cible i. Les sources j sont lues par tuiles de WG corps, chargées en mémoire partagée : chaque corps est lu
// une fois par groupe au lieu d'une fois par thread. GpuNBody ajoute avant la compilation : #define WG <threads par groupe>,
// et #define GPU_DOUBLE pour calculer en double.

#ifdef GPU_DOUBLE
#define real double
#define vec3r dvec3
#define vec4r dvec4
#else
#define real float
#define vec3r vec3
#define vec4r vec4
#endif

layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer Bodies { vec4r body[]; };    // (x, y, z, masse)
layout(std430, binding = 1) writeonly buffer Accel { vec4r accel[]; };   // (ax, ay, az, 0)

uniform int uCount;        // nombre de corps
uniform uint uFirstGroup;  // premier groupe de cet envoi (le calcul est découpé en plusieurs envois courts)
uniform real uG;
uniform real uEps2;        // eps^2

shared vec4r tile[WG];

void main() {
    const uint i = (gl_WorkGroupID.x + uFirstGroup) * WG + gl_LocalInvocationID.x;
    const uint n = uint(uCount);
    const vec4r bi = i < n ? body[i] : vec4r(0.0);
    vec3r a = vec3r(0.0);

    for (uint base = 0u; base < n; base += WG) {
        const uint j = base + gl_LocalInvocationID.x;
        tile[gl_LocalInvocationID.x] = j < n ? body[j] : vec4r(0.0);  // case de remplissage : masse nulle, sans effet
        barrier();
        for (uint k = 0u; k < WG; ++k) {
            const vec4r bj = tile[k];
            const vec3r d = bj.xyz - bi.xyz;
            const real r2 = dot(d, d) + uEps2;
            const real inv = inversesqrt(r2);
            // r2 = 0 seulement pour le corps lui-même sans adoucissement (ou une case de remplissage sur le corps 0) : force nulle.
            const real w = r2 > real(0.0) ? bj.w * inv * inv * inv : real(0.0);
            a += d * w;
        }
        barrier();  // tous les threads ont fini de lire la tuile avant qu'on la recharge
    }
    if (i < n) accel[i] = vec4r(uG * a, 0.0);
}
