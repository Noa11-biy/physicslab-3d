# Fins de ligne normalisées en LF dans le dépôt (Windows + Linux)
* text=auto eol=lf

# Scripts Windows : restent en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.ttf binary
*.otf binary
*.woff2 binary
*.zip binary
